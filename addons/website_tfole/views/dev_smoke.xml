<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        PHASE 0 SMOKE TEST.

        Proves the development loop: with the dev flags "xml,qweb,reload" an
        edit to this file is visible on the next browser refresh, with no
        container restart. Edit the marker content, refresh, view source.

        Renders nothing a visitor can see. Phase 2 introduces views/layout.xml
        for real header, nav and footer work; delete this file then.
    -->
    <template id="dev_smoke" inherit_id="website.layout" name="Tfole: dev smoke marker">
        <xpath expr="//head" position="inside">
            <meta name="tfole-build" content="phase-0"/>
        </xpath>
    </template>
</odoo>
