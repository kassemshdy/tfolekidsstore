<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_tfole_contact_cta" name="Chat to Us">
        <!-- WhatsApp deep link. wa.me wants the number in international
             format with no plus sign or separators. -->
        <section class="s_tfole_contact_cta pt48 pb48"
                 data-snippet="s_tfole_contact_cta" data-name="Chat to Us">
            <div class="container">
                <div class="o_tfole_cta_panel text-center">
                    <h2 class="mb-2">Not sure what suits?</h2>
                    <p class="mb-4">
                        Tell us the age and what they are into. We will point you
                        at two or three things.
                    </p>
                    <a href="https://wa.me/96171203505" class="btn btn-primary btn-lg"
                       target="_blank" rel="noopener">Message us on WhatsApp</a>
                </div>
            </div>
        </section>
    </template>
</odoo>
