<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_tfole_kit" name="The Activity Kit">
        <section class="s_tfole_kit pt48 pb48"
                 data-snippet="s_tfole_kit" data-name="The Activity Kit">
            <div class="container">
                <div class="row align-items-center g-4 g-lg-5 flex-lg-row-reverse">
                    <div class="col-lg-6">
                        <p class="o_tfole_eyebrow">The activity kit</p>
                        <h2 class="mb-3">Open the box.<br/>Let the playing start.</h2>
                        <p class="mb-4">
                            A board game, five decks of challenge cards, character
                            standees and a parents guide. Move, create, explore,
                            connect, be kind, with nothing to charge.
                        </p>
                                                <t t-set="categ" t-value="request.env.ref('website_tfole.categ_tfole_box', raise_if_not_found=False)"/>
                        <a t-att-href="categ and ('/shop/category/' + request.env['ir.http']._slug(categ)) or '/shop'"
                           class="btn btn-primary btn-lg">See what is in the kit</a>
                    </div>
                    <div class="col-lg-6">
                        <img src="/website_tfole/static/src/img/photos/full-kit.jpg"
                             alt="The Tfole Adventure activity kit, board game, card decks and parents guide"
                             class="img img-fluid rounded-4 w-100"/>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
