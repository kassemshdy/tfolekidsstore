<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Company and website identity.

        noupdate="1" on purpose: these are settings an operator edits in the UI
        (Settings > Website), and a plain data file would silently overwrite
        those edits on every "make upgrade". Set once at install; to re-apply
        this file after changing it, run "make reinit".

        Product data is the opposite case and is NOT noupdate - see
        product_images.xml.
    -->

    <record id="base.main_company" model="res.company">
        <field name="name">Tfole</field>
        <field name="country_id" ref="base.lb"/>

        <!--
            USD only, pinned explicitly rather than left to the default.
            base.lb carries currency_id = LBP, so anything that later derives a
            currency from the company country would flip pricing to Lebanese
            pounds. Pricing is USD; there is no LBP pricelist by decision.
        -->
        <field name="currency_id" ref="base.USD"/>

        <field name="phone">+961 71 203 505</field>
        <field name="email">infor@tfolekids.com</field>

        <!-- TODO(Tfole): still needed before launch. -->
        <!-- <field name="street">...</field> -->
        <!-- <field name="city">...</field> -->
    </record>

    <record id="website.default_website" model="website">
        <field name="name">Tfole</field>
        <field name="company_id" ref="base.main_company"/>

        <!--
            Shop grid. Odoo drives the column count from these, so the grid is
            a setting rather than a template override. 3 across on desktop
            keeps the cards large enough for the photography to carry; Odoo
            collapses to 2 and then 1 on smaller viewports on its own.
            24 per page divides evenly by both 3 and 2, so no ragged last row.
        -->
        <field name="shop_ppr">3</field>
        <field name="shop_ppg">24</field>

        <!-- The real wordmark, cropped from the brand artwork with the
             photographic backdrop removed. -->
        <field name="logo" type="base64" file="website_tfole/static/src/img/brand/tfole-logo.png"/>
        <field name="favicon" type="base64" file="website_tfole/static/src/img/brand/tfole-favicon.png"/>

        <!--
            Arabic is the primary language, so it is the site default and
            English sits at /en. Tfole's own site is Arabic-only; a Lebanese
            customer arriving from Instagram should not land on English.
        -->
        <field name="language_ids" eval="[(6, 0, [ref('base.lang_ar'), ref('base.lang_en')])]"/>
        <field name="default_lang_id" ref="base.lang_ar"/>

        <!--
            TODO(Tfole): social handles still needed. Deliberately not filled
            with invented values - a guessed handle points the whole storefront
            at somebody else's account.

            <field name="social_instagram">https://www.instagram.com/...</field>
            <field name="social_facebook">https://www.facebook.com/...</field>
            <field name="social_tiktok">https://www.tiktok.com/@...</field>
        -->
    </record>

</odoo>
