# Copy to .env and adjust. .env is gitignored.
#
# These are LOCAL DEVELOPMENT values. The Leaseweb host (Phase 8) gets its own
# secrets and does not read this file.

DB_USER=odoo
DB_PASSWORD=odoo

# Host ports. Change if 8069/8072 are already taken on your machine.
ODOO_PORT=8069
ODOO_GEVENT_PORT=8072
